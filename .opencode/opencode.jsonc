{"$schema":"https://opencode.ai/config.json","default_agent":"goal-executor","model":"opencode/nemotron-3-ultra-free","small_model":"opencode/muse-spark-1.3-contributor-free","steps":48,"experimental":{"portable_shell_scanner":true},"permissions":[{"action":"read","resource":"*","effect":"allow"},{"action":"read","resource":"*.env","effect":"deny"},{"action":"read","resource":"*.env.*","effect":"deny"},{"action":"read","resource":"*.pem","effect":"deny"},{"action":"read","resource":"*.key","effect":"deny"},{"action":"edit","resource":"*","effect":"allow"},{"action":"edit","resource":".opencode/**","effect":"deny"},{"action":"edit","resource":".github/**","effect":"deny"},{"action":"edit","resource":"AGENTS.md","effect":"deny"},{"action":"edit","resource":"CONTEXT.md","effect":"deny"},{"action":"edit","resource":"GLOSSARY.md","effect":"deny"},{"action":"edit","resource":".pre-commit-config.yaml","effect":"deny"},{"action":"edit","resource":"docs/adr/**","effect":"deny"},{"action":"glob","resource":"*","effect":"allow"},{"action":"grep","resource":"*","effect":"allow"},{"action":"shell","resource":"*","effect":"allow"},{"action":"shell","resource":"git push *","effect":"deny"},{"action":"shell","resource":"git reset --hard *","effect":"deny"},{"action":"shell","resource":"git clean *","effect":"deny"},{"action":"shell","resource":"rm -rf *","effect":"deny"},{"action":"shell","resource":"sudo *","effect":"deny"},{"action":"shell","resource":"mkfs *","effect":"deny"},{"action":"shell","resource":"powershell *","effect":"deny"},{"action":"shell","resource":"pwsh *","effect":"deny"},{"action":"shell","resource":"cmd.exe *","effect":"deny"},{"action":"external_directory","resource":"*","effect":"deny"},{"action":"subagent","resource":"*","effect":"deny"},{"action":"subagent","resource":"goal-reviewer","effect":"allow"}],"agents":{"goal-executor":{"description":"Bounded WSL2 goal executor","mode":"primary","model":"opencode/nemotron-3-ultra-free","steps":48,"system":"Work from AGENTS.md and CONTEXT.md. Plan, implement, verify deterministically, then ask goal-reviewer to independently inspect. Two repairs maximum per failed stage. Persist criteria, commands, outcomes, and review under .goal-loop/runs. The goal command owns reviewer delegation. Never push, merge, edit governance, or claim completion without evidence."},"goal-reviewer":{"description":"Independent read-only evaluator","mode":"subagent","model":"opencode/muse-spark-1.3-contributor-free","steps":16,"permissions":[{"action":"*","resource":"*","effect":"deny"},{"action":"read","resource":"*","effect":"allow"},{"action":"glob","resource":"*","effect":"allow"},{"action":"grep","resource":"*","effect":"allow"},{"action":"shell","resource":"git status *","effect":"allow"},{"action":"shell","resource":"git diff *","effect":"allow"},{"action":"shell","resource":"git log *","effect":"allow"}],"system":"Read only. Compare criteria with diff and test evidence. Report severity-ranked findings with file and line. End REVIEW: pass only if no blocking issue, else REVIEW: revise."}}}
